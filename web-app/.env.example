# Replace every placeholder with the PostgreSQL connection details for the local environment.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
BETTER_AUTH_SECRET="generate-a-random-secret-with-at-least-32-bytes"
BETTER_AUTH_URL="http://localhost:3000"

# Optional Google OAuth. Leave both unset until a real Google Cloud OAuth client exists.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
