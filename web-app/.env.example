# Replace every placeholder with the PostgreSQL connection details for the local environment.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
BETTER_AUTH_SECRET="generate-a-random-secret-with-at-least-32-bytes"
BETTER_AUTH_URL="http://localhost:3000"
# Development only: exact private-LAN hosts allowed to serve auth requests.
# Update this when the PC's LAN address changes; never use wildcards or public hosts.
BETTER_AUTH_DEV_HOSTS="192.168.1.25:3000"

# Optional Google OAuth. Use a dedicated ProgressVale Web application client.
# Local callback: http://localhost:3000/api/auth/callback/google
# Leave both unset until the real client exists; never commit its secret.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Brevo transactional email. Use an authorized sender; never commit real values.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="ProgressVale"
