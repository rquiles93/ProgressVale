generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AssessmentStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  FINALIZED
  ARCHIVED
}

enum ServiceSetting {
  HOME
  SCHOOL
  CLINIC_BASED
}

enum AssessmentLanguage {
  EN
  ES
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  displayName   String
  emailVerified Boolean        @default(false)
  // False is the permanent legacy cohort; new credential signups are set true server-side.
  emailVerificationRequired Boolean @default(false)
  image         String?
  identities    AuthIdentity[]
  sessions      Session[]
  clients       Client[]
  assessments   Assessment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model AuthIdentity {
  id                    String    @id @default(cuid())
  userId                String
  provider              String
  providerAccountId     String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model EmailActionThrottle {
  key             String   @id
  count           Int
  windowStartedAt DateTime
  lastAttemptAt   DateTime
  updatedAt       DateTime @updatedAt
}

model Client {
  id          String       @id @default(cuid())
  ownerId     String
  name        String
  identifier  String?
  dateOfBirth DateTime?    @db.Date
  serviceSettings ServiceSetting[] @default([])
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  assessments Assessment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([ownerId, identifier])
  @@unique([id, ownerId])
  @@index([ownerId, name])
}

model Assessment {
  id                    String            @id @default(cuid())
  clientId              String
  ownerId               String
  status                AssessmentStatus  @default(DRAFT)
  evaluationStartedAt   DateTime?
  evaluationCompletedAt DateTime?
  protocolVersion       String?
  serviceSettingsSnapshot ServiceSetting[] @default([])
  trackingColor         String?           @db.VarChar(7)
  language              AssessmentLanguage @default(EN)
  client                Client            @relation(fields: [clientId, ownerId], references: [id, ownerId], onDelete: Cascade)
  owner                 User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  scores                AssessmentScore[]
  notes                 AssessmentNote[]
  sections              AssessmentSection[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([ownerId, status])
  @@index([clientId, createdAt])
  @@unique([clientId, trackingColor])
}

model AssessmentSection {
  id             String     @id @default(cuid())
  assessmentId   String
  sectionCode    String
  defaultEnabled Boolean
  enabled        Boolean
  lockReason     String?
  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([assessmentId, sectionCode])
  @@index([assessmentId, enabled])
}

model AssessmentScore {
  id              String     @id @default(cuid())
  assessmentId    String
  skillIdentifier String
  // Null means unanswered; zero is an explicit assessed score.
  score           Int?
  maxScore        Int
  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  observedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([assessmentId, skillIdentifier])
  @@index([skillIdentifier])
}

model AssessmentNote {
  id              String     @id @default(cuid())
  assessmentId    String
  skillIdentifier String
  content         String     @db.Text
  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([assessmentId, skillIdentifier])
  @@index([skillIdentifier])
}
